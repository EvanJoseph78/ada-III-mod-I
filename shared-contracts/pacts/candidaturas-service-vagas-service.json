    {
      "description": "consultar criterios: ABERTA",
      "request": {
        "method": "GET",
        "path": "/api/v1/vagas/d71c12f0-2fd9-4b70-b19e-89d539be96b0/criterios"
      },
      "response": {
        "body": {
          "requisitos": [
            {
              "mesesMinimos": 6,
              "obrigatorio": true,
              "palavraChave": "Java",
              "pontos": 10,
              "tipo": "EXPERIENCIA_INTERNA"
            }
          ],
          "status": "ABERTA",
          "titulo": "Java",
          "vagaId": "d71c12f0-2fd9-4b70-b19e-89d539be96b0"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.requisitos": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.requisitos[*].mesesMinimos": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.requisitos[*].obrigatorio": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.requisitos[*].palavraChave": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.requisitos[*].pontos": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.titulo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 200
      }
